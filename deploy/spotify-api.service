[Unit]
Description=spotify-cli backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=spotify
Group=spotify
WorkingDirectory=/var/lib/spotify
EnvironmentFile=/etc/spotify/runtime.env
Environment=SPOTIFY_BIND=127.0.0.1:8787
Environment=SPOTIFY_DATABASE_PATH=/var/lib/spotify/spotify.sqlite
Environment=SPOTIFY_TELEMETRY_HOME=/var/lib/spotify/telemetry
ExecStart=/opt/spotify/current/spotify-api
Restart=on-failure
RestartSec=2
TimeoutStopSec=30
KillSignal=SIGINT
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/spotify
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
