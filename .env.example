# spotify-cli backend (spotify-api). Production values live in AWS Secrets Manager
# (unlikefraction-spotify/production/runtime) and are written to /etc/spotify/runtime.env on the host.
SPOTIFY_BIND=127.0.0.1:8787
SPOTIFY_DATABASE_PATH=spotify.sqlite
SPOTIFY_PUBLIC_ORIGIN=https://backend.spotify.unlikefraction.com
# IAM application (created with `honeycomb apps create deploy/honeycomb-application.json`)
SPOTIFY_IAM_URL=https://backend.iam.teamofsilicons.com
SPOTIFY_IAM_APP_ID=spotify
SPOTIFY_IAM_APP_SECRET=ask_...                      # 47 characters, shown once by Honeycomb
SPOTIFY_IAM_WEBHOOK_SECRET=...                      # the webhook_secret registered with the app (step 4)
SPOTIFY_IAM_WEBHOOK_KEY_VERSION=1
SPOTIFY_IAM_TIMEOUT_SECONDS=8
# Ting
SPOTIFY_TING_URL=https://backend.ting.teamofsilicons.com
SPOTIFY_TING_TIMEOUT_SECONDS=15
# Telemetry (Space Station). Missing keys disable a table; SPOTIFY_TELEMETRY=off disables all.
SPOTIFY_TELEMETRY=on
SPOTIFY_BACKEND_TABLE_KEY=table-spotifybackend-<32hex>
SPOTIFY_CLIDAEMON_TABLE_KEY=table-spotifyclidaemon-<32hex>
SPOTIFY_FRONTEND_ANALYTICS_TABLE_KEY=table-spotifyfrontendanalytics-<32hex>
SPOTIFY_FRONTEND_EVENTS_TABLE_KEY=table-spotifyfrontendevents-<32hex>
SPOTIFY_TELEMETRY_HOME=telemetry
SPOTIFY_TELEMETRY_URL=https://backend.spacestation.teamofsilicons.com
SPOTIFY_WEB_ORIGINS=https://spotify.unlikefraction.com
# Optional: file bug reports as GitHub issues (fine-grained token, Issues: write on the repo)
SPOTIFY_GITHUB_TOKEN=
SPOTIFY_GITHUB_REPOSITORY=unlikefraction/spotify-cli
# Backups (host only)
SPOTIFY_BACKUP_BUCKET=
RUST_LOG=info
