{
  "name": "silicon-spotify-docs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1 --port 4321",
    "build": "npm test && NEXT_TELEMETRY_DISABLED=1 next build && node scripts/assets.mjs && node scripts/csp.mjs && node check.mjs",
    "check": "tsc --noEmit && node check.mjs",
    "serve": "node serve.mjs",
    "test": "node --test tests/*.test.mjs check.test.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "lucide-react": "1.54.0",
    "marked": "18.0.11",
    "motion": "13.5.1",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3"
  }
}
